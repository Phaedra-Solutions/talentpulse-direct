# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, metadata canonical URLs, and API endpoints.
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Required only if Gemini AI features are enabled server-side.
# Never prefix with NEXT_PUBLIC_ and never commit real keys to version control.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SUPABASE CONFIGURATION
# Connect to your Supabase PostgreSQL project for persistent storage & auth.
# Get these in your Supabase Dashboard -> Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# CLIENT KEY (Safe for browser / public use under RLS)
# Use modern Publishable key (sb_pub_...) OR legacy anon key (ey...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_pub_..."
# Alternatively, legacy alias:
NEXT_PUBLIC_SUPABASE_ANON_KEY="ey..."

# SERVER KEY (Secret - Bypasses RLS - Server Actions & Route Handlers only)
# Never prefix with NEXT_PUBLIC_! Use modern Secret key (sb_sec_...) OR legacy service_role key
SUPABASE_SECRET_KEY="sb_sec_..."
# Alternatively, legacy alias:
SUPABASE_SERVICE_ROLE_KEY="ey..."

# AUTH / HMAC SESSION SIGNING SECRET (Server only)
# Used to sign admin session cookies/tokens (admin_session), invite tokens, and
# derive the AES-256-GCM encryption key for ~/.talentpulse/do-spaces.enc.json.
# Set a strong random 32+ byte secret in production. If omitted in local dev,
# a random secret is generated at runtime in gitignored data/.jwt_secret.
JWT_SECRET=""

# DIGITALOCEAN SPACES OBJECT STORAGE (Private Candidate Resumes)
# Path hierarchy: Talent Pulse/{Month-Year}/candidate/{candidateId}_{filename}
# ACL: private (served exclusively via authenticated /api/candidates/resume proxy)
#
# Note: Use the regional endpoint (e.g. https://sgp1.digitaloceanspaces.com)
# WITHOUT the bucket name subdomain prefix to prevent TLS certificate mismatches.
# Access/Secret keys can be provided here OR saved via the Admin Dashboard,
# which stores them AES-256-GCM encrypted outside the repo (~/.talentpulse/do-spaces.enc.json).
DO_SPACES_ENDPOINT="https://sgp1.digitaloceanspaces.com"
DO_SPACES_REGION="sgp1"
DO_SPACES_BUCKET="your-spaces-bucket"
DO_SPACES_KEY="DO00EXAMPLEKEY123"
DO_SPACES_SECRET="example_secret_access_key_xyz"
